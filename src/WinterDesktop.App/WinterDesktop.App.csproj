<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinterDesktop.App</RootNamespace>
    <AssemblyName>WinterDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Description>Winter Desktop — интерактивные зимние эффекты поверх рабочего стола Windows.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- WPF-приложение с WinForms-треем: DPI задаётся манифестом (PerMonitorV2), а не API WinForms. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinterDesktop.Core\WinterDesktop.Core.csproj" />
    <ProjectReference Include="..\WinterDesktop.Settings\WinterDesktop.Settings.csproj" />
    <ProjectReference Include="..\WinterDesktop.SnowEngine\WinterDesktop.SnowEngine.csproj" />
    <ProjectReference Include="..\WinterDesktop.Platform\WinterDesktop.Platform.csproj" />
    <ProjectReference Include="..\WinterDesktop.Renderer\WinterDesktop.Renderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
